{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silema",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 边缘缓存在 Worker 执行之前先查，命中就不跑 isolate。默认是关的；开启后**任何** 200 的 GET
  // 即使不带 Cache-Control 也会被缓存 2 小时，所以 app.tsx 的全局中间件先把所有响应压成
  // no-store，只有内容寻址过的 /assets/* 显式放行 immutable。加新路由时别忘了这个前提。
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "silema",
      "database_id": "aca7c6c0-d026-4fdb-9983-2b913b6e77b6",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    // Cloudflare 自动建 AAAA 100:: 记录并签证书；需要的是 Workers Routes Write，不是 DNS 写权限
    { "pattern": "slm.liejiu.top", "custom_domain": true }
  ],
  "triggers": {
    // 北京 12:00（cron 表达式为 UTC）唯一一次运行：先判定上一周期，再发出今天那唯一的一条。
    // 判定刻意不单独占一条 cron——Free 计划的 cron trigger 是**账号级 5 条**。
    "crons": ["0 4 * * *"]
  },
  "vars": {
    "SITE_URL": "https://slm.liejiu.top",
    "MOCK_SEND": "0"
  }
}
