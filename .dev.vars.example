# 本地与生产都不入库的凭据。生产用 `wrangler secret put <NAME>`。
# 本地预览：`npm run db:seed` 会自动生成一份 .dev.vars。

# 登录凭据不入库（README「端点 · 认证」）。三者任一缺失 → 需登录接口一律 503。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=

# 邮件通道（Resend HTTP API，README「通知通道」）。生产用 `wrangler secret put EMAIL_API_KEY`。
# 两者任一缺失 → email 通道发送即失败并记 cron error，其余通道不受影响。
# EMAIL_FROM 必须是已在 Resend 验证过的域名下的地址，例如 silema@mail.liejiu.top
EMAIL_API_KEY=
EMAIL_FROM=

# 外部心跳（Healthchecks.io 式），两个 job 各一个独立 check：send 阈值 13h、judge 阈值 25h（README「自监控与运维」）。
# 共用一个 check 时 12:00 的 send 会把 judge 静默不跑也一起喂掉，永远不会告警。
# 填 check 的 ping 地址（不含末尾的 /pass 或 /fail），任务跑到就 POST <URL>/pass，失败则 <URL>/fail。
# 告警接收方必须独立于所有者本人——这套兜底的前提就是所有者已失联。
HEARTBEAT_SEND_URL=
HEARTBEAT_JUDGE_URL=

# 本地预览专用
SITE_URL=http://localhost:5173
MOCK_SEND=1
DEV_HELPER=1
